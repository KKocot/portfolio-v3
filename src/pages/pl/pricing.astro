---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PricingForm from '../../components/PricingForm.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n';

const lang = 'pl';
const t = getTranslations(lang);
---

<Layout
  title="Wycena | Krzysztof Kocot"
  description="Przejrzyste ceny projektów webowych i mobilnych. Landing page, strony firmowe, sklepy internetowe, aplikacje webowe i mobilne."
  lang={lang}
>
  <Navbar lang={lang} t={t} />
  <main class="pt-20">
    <PricingForm t={t} lang={lang} />
    <QuoteForm t={t} lang={lang} />
  </main>
  <Footer t={t} />
</Layout>
