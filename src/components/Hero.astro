---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
  name: string;
}

const { t, name } = Astro.props;
---

<section id="hero" class="min-h-screen flex items-center pt-[72px] relative">
  <!-- Hero glow -->
  <div class="hero-glow absolute top-1/2 left-1/4 w-[600px] h-[600px] -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0" style="background: radial-gradient(ellipse at center, rgba(124, 58, 237, 0.06) 0%, rgba(124, 58, 237, 0.02) 40%, transparent 70%);"></div>

  <div class="max-w-[1200px] mx-auto px-6 w-full py-16 lg:py-24 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Portrait/Visual - Left side on desktop -->
      <div class="order-1 flex justify-center lg:justify-start hero-animate hero-delay-0">
        <div class="relative">
          <!-- Portrait container -->
          <div class="relative rounded-2xl overflow-hidden aspect-[3/4] w-72 sm:w-80 lg:w-[380px] max-w-[480px] mx-auto lg:mx-0" style="background: var(--color-bg-card); border: 1px solid var(--color-border);">

            <!-- Portrait image with fallback -->
            <img
              src="/portrait.jpg"
              alt="Krzysztof Kocot — Full-Stack Developer"
              class="portrait-image w-full h-full object-cover"
              loading="eager"
              decoding="async"
              onerror="this.style.display='none'; document.getElementById('portrait-fallback')?.classList.remove('hidden');"
            />

            <!-- Fallback (when portrait.jpg is missing) -->
            <div id="portrait-fallback" class="hidden absolute inset-0 flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-bg-card), var(--color-bg-elevated));" aria-hidden="true">
              <span class="text-7xl sm:text-8xl lg:text-9xl font-bold" style="font-family: var(--font-family-display); color: rgba(139, 92, 246, 0.15);">KK</span>
            </div>

            <!-- Subtle bottom gradient overlay -->
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, transparent 60%, rgba(10, 10, 10, 0.4));"></div>

            <!-- Subtle inner violet glow (vignette) -->
            <div class="absolute inset-0 pointer-events-none" style="box-shadow: inset 0 0 120px rgba(139, 92, 246, 0.08); border-radius: inherit;"></div>
          </div>

          <!-- Availability badge -->
          <div class="absolute bottom-[-12px] left-1/2 -translate-x-1/2 lg:left-8 lg:translate-x-0 rounded-full px-3 sm:px-4 py-2 flex items-center gap-2" style="background: var(--color-bg); border: 1px solid var(--color-border); backdrop-filter: blur(8px);" role="status">
            <span class="w-2 h-2 rounded-full" style="background: var(--color-success); animation: pulse 2s ease-in-out infinite;" aria-hidden="true"></span>
            <span class="text-[11px] sm:text-xs" style="color: var(--color-text-muted);">{t.hero.available}</span>
          </div>
        </div>
      </div>

      <!-- Content - Right side on desktop -->
      <div class="order-2 lg:text-left text-center lg:pl-8">
        <span class="section-tag hero-animate hero-delay-1">
          {t.hero.role}
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-[4rem] font-bold leading-[1.1] tracking-tight mb-6 hero-animate hero-delay-2" style="font-family: var(--font-family-display); letter-spacing: -0.03em;">
          {t.hero.tagline}<br />
          <span class="gradient-text">{name}</span>
        </h1>

        <p class="text-base lg:text-lg mb-8 hero-animate hero-delay-3 max-w-lg lg:max-w-none mx-auto lg:mx-0" style="color: var(--color-text-muted); line-height: 1.7;">
          {t.hero.description}
        </p>

        <div class="flex flex-wrap gap-4 items-center justify-center lg:justify-start hero-animate hero-delay-4">
          <a href="#contact" class="btn btn-primary">
            {t.hero.cta.contact}
          </a>
          <a
            href="#projects"
            class="text-sm font-medium inline-flex items-center gap-1 transition-colors hero-projects-link"
          >
            {t.hero.cta.projects} <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator - hidden on mobile -->
  <div class="hidden sm:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 hero-animate hero-delay-5">
    <span class="text-xs uppercase tracking-widest" style="color: var(--color-text-subtle);">{t.hero.scroll}</span>
    <div class="w-px h-10 scroll-line" style="background: linear-gradient(to bottom, var(--color-text-subtle), transparent);"></div>
  </div>
</section>
