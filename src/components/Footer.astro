---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const name = 'Krzysztof Kocot';

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/KKocot' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/krzysztof-kocot-b3043a220/' },
];

const website = 'bard-dev.com';
---

<footer class="py-8" style="background: var(--color-bg); border-top: 1px solid var(--color-border);">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo -->
      <span class="text-xl font-bold" style="color: var(--color-text);">
        KK<span style="color: var(--color-primary);">.</span>
      </span>

      <!-- Copyright + Location -->
      <div class="text-center">
        <p class="text-sm" style="color: var(--color-text-subtle);">
          &copy; {new Date().getFullYear()} {name}. {t.footer.rights}
        </p>
        <p class="text-xs mt-1" style="color: var(--color-text-subtle);">
          {t.footer.location}
        </p>
      </div>

      <!-- Links -->
      <div class="flex gap-6">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm transition-colors footer-link-hover"
          >
            {link.name}
          </a>
        ))}
        <a
          href={`https://${website}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-colors footer-link-hover"
        >
          {website}
        </a>
      </div>
    </div>
  </div>
</footer>
