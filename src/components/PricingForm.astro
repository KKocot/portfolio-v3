---
import type { Translations, Language } from '../i18n/translations';

interface Props {
  t: Translations;
  lang: Language;
}

const { t, lang } = Astro.props;

const pricingTypes = Object.entries(t.pricing.types) as [
  string,
  {
    name: string;
    description: string;
    projectMin: number;
    projectMax: number;
    adminMin: number;
    adminMax: number;
  }
][];

function formatPrice(price: number): string {
  return price.toLocaleString('pl-PL');
}
---

<section id="pricing" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="section-tag">{t.pricing.tag}</span>
      <h2 class="section-title whitespace-pre-line">{t.pricing.title}</h2>
      <p class="mt-6 text-lg text-text-muted max-w-2xl mx-auto">
        {t.pricing.description}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {pricingTypes.map(([key, type]) => (
        <div class="pricing-card group">
          <div class="p-6">
            <h3 class="text-xl font-bold text-white mb-2">{type.name}</h3>
            <p class="text-sm text-text-muted mb-6 min-h-[48px]">{type.description}</p>

            <div class="space-y-4">
              <div class="pricing-row">
                <span class="text-sm text-text-muted">{t.pricing.projectCost}</span>
                <div class="text-right">
                  <span class="text-lg font-semibold text-white">
                    {formatPrice(type.projectMin)} - {formatPrice(type.projectMax)}
                  </span>
                  <span class="text-sm text-text-muted ml-1">PLN</span>
                </div>
              </div>

              <div class="pricing-row">
                <span class="text-sm text-text-muted">{t.pricing.adminCost}</span>
                <div class="text-right">
                  <span class="text-lg font-semibold text-primary">
                    {formatPrice(type.adminMin)} - {formatPrice(type.adminMax)}
                  </span>
                  <span class="text-sm text-text-muted ml-1">PLN{t.pricing.perYear}</span>
                </div>
              </div>
            </div>
          </div>

          <div class="px-6 pb-6">
            <a
              href={`#quote-form?type=${key}`}
              data-project-type={key}
              class="btn btn-outline w-full justify-center group-hover:bg-primary group-hover:border-primary group-hover:text-black quote-btn"
            >
              {t.pricing.getQuote}
            </a>
          </div>
        </div>
      ))}
    </div>

    <p class="text-center text-sm text-text-muted mt-10">
      {t.pricing.note}
    </p>
  </div>
</section>

<style>
  .pricing-card {
    display: flex;
    flex-direction: column;
    border-radius: 0.5rem;
    overflow: hidden;
    transition: all 0.3s ease;
    background-color: rgba(250, 250, 250, 0.03);
    border: 1px solid rgba(250, 250, 250, 0.08);
  }

  .pricing-card:hover {
    transform: translateY(-0.5rem);
    border-color: var(--color-primary);
    box-shadow: 0 20px 40px rgba(16, 185, 129, 0.15);
  }

  .pricing-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(250, 250, 250, 0.06);
  }

  .pricing-row:last-child {
    border-bottom: none;
  }

  .text-primary {
    color: var(--color-primary);
  }

  .text-text-muted {
    color: rgba(250, 250, 250, 0.5);
  }
</style>

<script>
  function initQuoteButtons() {
    const buttons = document.querySelectorAll('.quote-btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const projectType = (btn as HTMLElement).dataset.projectType;

        // Scroll to form
        const form = document.getElementById('quote-form');
        if (form) {
          form.scrollIntoView({ behavior: 'smooth' });
        }

        // Set project type after small delay to ensure scroll started
        if (projectType) {
          setTimeout(() => {
            const select = document.getElementById('quote-project-type') as HTMLSelectElement;
            if (select) {
              select.value = projectType;
              select.dispatchEvent(new Event('change'));
            }
          }, 100);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initQuoteButtons);
  document.addEventListener('astro:page-load', initQuoteButtons);
</script>
