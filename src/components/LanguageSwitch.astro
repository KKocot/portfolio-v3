---
interface Props {
  currentLang: 'en' | 'pl';
}

const { currentLang } = Astro.props;
---

<div class="lang-switch">
  <button
    class={`lang-btn ${currentLang === 'en' ? 'active' : ''}`}
    data-lang="en"
    aria-label="Switch to English"
    aria-pressed={currentLang === 'en' ? 'true' : 'false'}
  >
    EN
  </button>
  <button
    class={`lang-btn ${currentLang === 'pl' ? 'active' : ''}`}
    data-lang="pl"
    aria-label="Przełącz na polski"
    aria-pressed={currentLang === 'pl' ? 'true' : 'false'}
  >
    PL
  </button>
</div>

<script>
  // Get all language switches (desktop and mobile)
  const langSwitches = document.querySelectorAll('.lang-switch');

  // Get current language from URL (single source of truth)
  function getCurrentLang(): 'en' | 'pl' {
    return window.location.pathname.startsWith('/pl') ? 'pl' : 'en';
  }

  // Set language and navigate to appropriate localized route
  function setLang(lang: 'en' | 'pl') {
    if (localStorage.getItem('lang') !== lang) {
      localStorage.setItem('lang', lang);
    }
    const current_path = window.location.pathname;

    if (lang === 'pl' && !current_path.startsWith('/pl')) {
      // Switch to Polish: add /pl prefix
      // Handle root path separately to avoid double slashes
      const new_path = current_path === '/' ? '/pl' : '/pl' + current_path;
      window.location.href = new_path;
    } else if (lang === 'en' && current_path.startsWith('/pl')) {
      // Switch to English: remove /pl prefix
      const new_path = current_path.replace(/^\/pl/, '') || '/';
      window.location.href = new_path;
    }
  }

  // Apply to all language switches
  langSwitches.forEach(langSwitch => {
    const buttons = langSwitch.querySelectorAll('.lang-btn');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = (btn as HTMLElement).dataset.lang as 'en' | 'pl';
        setLang(lang);
      });
    });

    // Update active state based on URL and sync localStorage
    const currentLang = getCurrentLang();
    if (localStorage.getItem('lang') !== currentLang) {
      localStorage.setItem('lang', currentLang);
    }
    buttons.forEach((btn) => {
      const btnLang = (btn as HTMLElement).dataset.lang;
      const isActive = btnLang === currentLang;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });
  });
</script>
