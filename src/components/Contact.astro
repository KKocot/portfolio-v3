---
import type { Translations, Language } from '../i18n';
import { Icon } from 'astro-icon/components';

interface Props {
  t: Translations;
  lang: Language;
}

const { t, lang } = Astro.props;
const contact = {
  email: 'k.kocot0@gmail.com',
  website: 'bard-dev.com',
};

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/KKocot', icon: 'github' as const },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/krzysztof-kocot-b3043a220/',
    icon: 'linkedin' as const,
  },
];

const toastMessages = {
  success: t.contact.toast.success,
  error: t.contact.toast.error,
};
---

<section id="contact" class="section-surface-contact py-20 lg:py-28">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Info -->
      <div class="flex flex-col justify-start">
        <span class="section-tag">{t.contact.tag}</span>
        <h2 class="section-title mb-6 whitespace-pre-line">{t.contact.title}</h2>

        <p class="mb-6" style="color: var(--color-text-muted);">
          {t.contact.description}
        </p>

        <!-- Contact Details -->
        <div class="space-y-4 mb-8">
          <a
            href={`mailto:${contact.email}`}
            class="contact-method flex items-center gap-4 transition-colors group"
            style="--item-color: var(--color-primary); color: var(--color-text-muted);"
          >
            <span class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: color-mix(in srgb, var(--item-color) 18%, transparent); border: 1px solid color-mix(in srgb, var(--item-color) 42%, transparent);">
              <svg class="w-5 h-5" style="color: var(--item-color);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <span class="group-hover:text-[--color-primary] transition-colors">{contact.email}</span>
          </a>

          <a
            href={`https://${contact.website}`}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-method flex items-center gap-4 transition-colors group"
            style="--item-color: var(--color-accent); color: var(--color-text-muted);"
          >
            <span class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: color-mix(in srgb, var(--item-color) 18%, transparent); border: 1px solid color-mix(in srgb, var(--item-color) 42%, transparent);">
              <svg class="w-5 h-5" style="color: var(--item-color);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </span>
            <span class="group-hover:text-[--color-primary] transition-colors">{contact.website}</span>
          </a>

          <div class="contact-method flex items-center gap-4" style="--item-color: var(--color-primary); color: var(--color-text-muted);">
            <span class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: color-mix(in srgb, var(--item-color) 18%, transparent); border: 1px solid color-mix(in srgb, var(--item-color) 42%, transparent);">
              <svg class="w-5 h-5" style="color: var(--item-color);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <span>{t.contact.location}</span>
          </div>
        </div>

        <!-- Social Links -->
        <div class="flex gap-4">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="w-11 h-11 flex items-center justify-center rounded-full transition-[transform,color,border-color] duration-150 ease-out hover:-translate-y-0.5 social-link-hover"
            >
              <Icon name={link.icon} class="w-5 h-5" aria-hidden="true" />
            </a>
          ))}
        </div>

        <!-- Quick Reply -->
        <div class="mt-8 pt-8" style="border-top: 1px solid var(--color-border);">
          <p class="text-sm" style="color: var(--color-text-muted);">{t.contact.quickReply}</p>
        </div>
      </div>

      <!-- Form -->
      <form
        id="contact-form"
        class="contact-form-card p-8 rounded-2xl"
        style="--item-color: var(--color-primary);"
        data-success-message={toastMessages.success}
        data-error-message={toastMessages.error}
      >
        <div class="mb-6">
          <label for="name" class="block text-sm font-medium mb-2" style="color: var(--color-text);">
            {t.contact.form.name}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="input-field"
          />
        </div>

        <div class="mb-6">
          <label for="email" class="block text-sm font-medium mb-2" style="color: var(--color-text);">
            {t.contact.form.email}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="input-field"
          />
        </div>

        <div class="mb-6">
          <label for="message" class="block text-sm font-medium mb-2" style="color: var(--color-text);">
            {t.contact.form.message}
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="input-field resize-y min-h-[120px]"
          ></textarea>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary w-full">
          <span id="submit-text">{t.contact.form.submit}</span>
          <span id="submit-loading" class="hidden">{t.contact.form.sending}</span>
        </button>

        <p
          id="form-error"
          role="alert"
          class="hidden mt-4 text-sm rounded-lg px-4 py-3"
          style="color: var(--color-text); border: 1px solid color-mix(in srgb, var(--color-error) 45%, transparent); background: color-mix(in srgb, var(--color-error) 16%, transparent);"
        >
          {t.contact.toast.error}
          {' '}
          <a href={`mailto:${contact.email}`} class="underline" style="color: var(--color-text);">{contact.email}</a>
        </p>
      </form>
    </div>
  </div>
</section>

<!-- Toast container -->
<div id="toast-container" class="toast-container" role="status" aria-live="polite"></div>

<script>
  import { sendContactForm } from '../services/contact';
  import type { ContactFormData } from '../services/contact';

  function showToast(message: string, type: 'success' | 'error') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;

    const icon = type === 'success' ? '\u2713' : '\u2715';
    const iconSpan = document.createElement('span');
    iconSpan.textContent = icon;
    const msgSpan = document.createElement('span');
    msgSpan.textContent = message;
    toast.replaceChildren(iconSpan, msgSpan);

    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.add('toast-exit');
      setTimeout(() => {
        toast.remove();
      }, 300);
    }, 5000);
  }

  let formInitialized = false;

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const submitText = document.getElementById('submit-text');
    const submitLoading = document.getElementById('submit-loading');
    const formError = document.getElementById('form-error');

    if (!form || !submitBtn || !submitText || !submitLoading) return;

    const showFormError = () => formError?.classList.remove('hidden');
    const hideFormError = () => formError?.classList.add('hidden');

    // Prevent multiple bindings
    if (formInitialized && form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';
    formInitialized = true;

    const successMessage = form.dataset.successMessage || 'Message sent successfully!';
    const errorMessage = form.dataset.errorMessage || 'Something went wrong.';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name');
      const email = formData.get('email');
      const message = formData.get('message');

      hideFormError();

      // Validate form data exists
      if (typeof name !== 'string' || typeof email !== 'string' || typeof message !== 'string') {
        showToast(errorMessage, 'error');
        showFormError();
        return;
      }

      const data: ContactFormData = { name, email, message };

      // Show loading state
      submitBtn.disabled = true;
      submitText.classList.add('hidden');
      submitLoading.classList.remove('hidden');

      try {
        const response = await sendContactForm(data);

        if (response.success) {
          showToast(successMessage, 'success');
          form.reset();
        } else {
          showToast(errorMessage, 'error');
          showFormError();
        }
      } catch {
        showToast(errorMessage, 'error');
        showFormError();
      } finally {
        // Reset button state
        submitBtn.disabled = false;
        submitText.classList.remove('hidden');
        submitLoading.classList.add('hidden');
      }
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initContactForm);
  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initContactForm);
</script>
