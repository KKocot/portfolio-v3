---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const steps = [
  {
    number: '01',
    title: t.process.steps.step1.title,
    desc: t.process.steps.step1.desc,
    icon: 'chat',
  },
  {
    number: '02',
    title: t.process.steps.step2.title,
    desc: t.process.steps.step2.desc,
    icon: 'design',
  },
  {
    number: '03',
    title: t.process.steps.step3.title,
    desc: t.process.steps.step3.desc,
    icon: 'code',
  },
  {
    number: '04',
    title: t.process.steps.step4.title,
    desc: t.process.steps.step4.desc,
    icon: 'shield',
  },
];
---

<section id="process" class="py-20 lg:py-28">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="section-tag">{t.process.tag}</span>
      <h2 class="section-title">{t.process.title}</h2>
    </div>

    <!-- Steps -->
    <div class="relative">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
        {steps.map((step, index) => (
          <div
            class="animate-on-scroll relative flex flex-col items-center text-center"
            data-stagger-index={index}
          >
            <!-- Icon circle + arrow connector wrapper -->
            <div class="relative w-full flex items-center justify-center mb-4">
              <!-- Arrow connector (desktop only, not on last step) -->
              {index < steps.length - 1 && (
                <div class="hidden lg:flex absolute left-[calc(50%+2.75rem)] right-[calc(-50%+2.75rem)] items-center" style="top: 50%; transform: translateY(-50%);">
                  <svg class="w-full h-3" viewBox="0 0 100 12" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <line x1="0" y1="6" x2="88" y2="6" stroke="var(--color-border-hover)" stroke-width="1" stroke-dasharray="4 3" stroke-linecap="round" opacity="0.5"/>
                    <path d="M86 2 L96 6 L86 10" stroke="var(--color-border-hover)" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                  </svg>
                </div>
              )}
              <!-- Icon circle -->
              <div class="relative z-10 w-14 h-14 rounded-full flex items-center justify-center shrink-0" style={`background: var(--color-primary-muted); border: 1px solid var(--color-border-active);`}>
              {step.icon === 'chat' && (
                <svg class="w-6 h-6" style="color: var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
              )}
              {step.icon === 'design' && (
                <svg class="w-6 h-6" style="color: var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="18" rx="1"/>
                  <rect x="14" y="3" width="7" height="8" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
              )}
              {step.icon === 'code' && (
                <svg class="w-6 h-6" style="color: var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              )}
              {step.icon === 'shield' && (
                <svg class="w-6 h-6" style="color: var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              )}
              </div>
            </div>

            <!-- Step number -->
            <span class="text-xs font-semibold mb-2" style="color: var(--color-primary);">{step.number}</span>

            <!-- Title -->
            <h3 class="text-lg font-semibold mb-2" style="font-family: var(--font-family-display); color: var(--color-text);">
              {step.title}
            </h3>

            <!-- Description -->
            <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
