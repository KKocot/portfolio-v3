---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const steps = [
  {
    number: '01',
    title: t.process.steps.step1.title,
    desc: t.process.steps.step1.desc,
    icon: 'chat',
    color: 'var(--color-primary)',
  },
  {
    number: '02',
    title: t.process.steps.step2.title,
    desc: t.process.steps.step2.desc,
    icon: 'design',
    color: 'var(--color-primary)',
  },
  {
    number: '03',
    title: t.process.steps.step3.title,
    desc: t.process.steps.step3.desc,
    icon: 'code',
    color: 'var(--color-accent)',
  },
  {
    number: '04',
    title: t.process.steps.step4.title,
    desc: t.process.steps.step4.desc,
    icon: 'shield',
    color: 'var(--color-accent)',
  },
];
---

<section id="process" class="section-surface-process py-20 lg:py-28">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">

      <!-- LEFT: 2x2 steps grid -->
      <div class="order-2 lg:order-1">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {steps.map((step, index) => (
            <div
              class="process-step-card flex flex-col items-center text-center"
              style={`--item-color: ${step.color};`}
            >
              <!-- Icon circle -->
              <div class="w-14 h-14 rounded-full flex items-center justify-center shrink-0 mb-4" style={`background: color-mix(in srgb, ${step.color} 18%, transparent); border: 1px solid color-mix(in srgb, ${step.color} 52%, transparent);`}>
                {step.icon === 'chat' && (
                  <svg class="w-6 h-6" style={`color: ${step.color};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                  </svg>
                )}
                {step.icon === 'design' && (
                  <svg class="w-6 h-6" style={`color: ${step.color};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="18" rx="1"/>
                    <rect x="14" y="3" width="7" height="8" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                  </svg>
                )}
                {step.icon === 'code' && (
                  <svg class="w-6 h-6" style={`color: ${step.color};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                  </svg>
                )}
                {step.icon === 'shield' && (
                  <svg class="w-6 h-6" style={`color: ${step.color};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                )}
              </div>

              <!-- Step number -->
              <span
                class="block text-4xl lg:text-5xl leading-none mb-3"
                style={`font-family: var(--font-family-accent); font-style: italic; color: ${step.color};`}
              >{step.number}</span>

              <!-- Title -->
              <h3 class="text-lg font-semibold mb-2" style="font-family: var(--font-family-display); color: var(--color-text);">
                {step.title}
              </h3>

              <!-- Description -->
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT: header content -->
      <div class="order-1 lg:order-2 flex flex-col justify-between">
        <div>
          <span class="section-tag">{t.process.tag}</span>
          <h2 class="section-title whitespace-pre-line">{t.process.title}</h2>
          <p class="text-sm leading-relaxed mt-4" style="color: var(--color-text-muted);">{t.process.sectionDescription}</p>

          <div class="mt-8">
            <h3 class="text-xs font-semibold uppercase tracking-wider mb-4" style="color: var(--color-text-muted);">{t.process.principlesTitle}</h3>
            <ul class="space-y-3">
              {t.process.principles.map((principle) => (
                <li class="flex items-start gap-3 text-sm" style="color: var(--color-text-muted);">
                  <span class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" style="background: var(--color-primary);"></span>
                  <span>{principle}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href="#contact" class="btn btn-outline mt-8">{t.process.cta}</a>
      </div>

    </div>
  </div>
</section>
