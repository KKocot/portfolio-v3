---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

interface ProjectLink {
  label: string;
  url: string;
  primary?: boolean;
}

interface Project {
  title: string;
  description: string;
  tags: string[];
  type: string;
  links: ProjectLink[];
}

interface ProjectMetric {
  value: string;
  label: string;
}

interface ProjectHighlight {
  label: string;
  color: string;
}

interface MeshBlob {
  color: string;
  position: string;
  animation: string;
}

interface FeaturedProject extends Project {
  gradient: string;
  accentColor: string;
  metrics: ProjectMetric[];
  highlights: ProjectHighlight[];
  meshBlobs: MeshBlob[];
}

const typeColors: Record<string, string> = {
  'Commercial': 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
  'Full-Stack App': 'bg-orange-500/20 text-orange-400 border-orange-500/30',
  'Backend': 'bg-violet-500/20 text-violet-400 border-violet-500/30',
  'Client': 'bg-blue-500/20 text-blue-400 border-blue-500/30',
};

const heroProject: FeaturedProject = {
  title: 'ConqSite',
  description: t.projects.descriptions.conqsite,
  tags: ['Next.js', 'MongoDB', 'Discord OAuth', 'Konva', 'Leaflet', 'Tailwind'],
  type: 'Full-Stack App',
  gradient: 'var(--gradient-conqsite)',
  accentColor: '#F59E0B',
  metrics: [
    { value: '20+', label: t.projects.metrics.pages },
  ],
  highlights: [
    { label: t.projects.metrics.canvasEditor, color: 'rgba(245, 158, 11, 0.15)' },
    { label: t.projects.metrics.worldMap, color: 'rgba(239, 68, 68, 0.12)' },
    { label: t.projects.metrics.premiumSystem, color: 'rgba(245, 158, 11, 0.1)' },
  ],
  meshBlobs: [
    { color: 'rgba(245, 158, 11, 0.25)', position: 'top: -10%; right: -5%;', animation: 'meshFloat1 9s ease-in-out infinite' },
    { color: 'rgba(239, 68, 68, 0.2)', position: 'bottom: 10%; left: -10%;', animation: 'meshFloat2 11s ease-in-out infinite' },
    { color: 'rgba(245, 158, 11, 0.1)', position: 'top: 40%; right: 25%;', animation: 'meshFloat3 13s ease-in-out infinite' },
  ],
  links: [
    { label: 'Live', url: 'https://conqsite.bard-dev.com', primary: true },
  ],
};

const secondaryProjects: FeaturedProject[][] = [
  [
    {
      title: 'Elysia Backend',
      description: t.projects.descriptions.elysiaBackend,
      tags: ['Bun', 'Elysia', 'MongoDB', 'Zod', 'JWT'],
      type: 'Backend',
      gradient: 'linear-gradient(135deg, #8B5CF6 0%, #4F46E5 100%)',
      accentColor: '#8B5CF6',
      metrics: [
        { value: '8', label: t.projects.metrics.appsServed },
        { value: '11', label: t.projects.metrics.apiModules },
      ],
      highlights: [
        { label: t.projects.metrics.aiPowered, color: 'rgba(139, 92, 246, 0.15)' },
      ],
      meshBlobs: [
        { color: 'rgba(139, 92, 246, 0.2)', position: 'top: -15%; left: -10%;', animation: 'meshFloat1 9s ease-in-out infinite' },
        { color: 'rgba(79, 70, 229, 0.15)', position: 'bottom: -10%; right: -5%;', animation: 'meshFloat2 11s ease-in-out infinite' },
      ],
      links: [],
    },
    {
      title: 'Denser',
      description: t.projects.descriptions.denser,
      tags: ['Next.js', 'TypeScript', 'Hive Blockchain', 'Playwright', 'Turbo'],
      type: 'Commercial',
      gradient: 'var(--gradient-denser)',
      accentColor: '#06B6D4',
      metrics: [
        { value: '50+', label: t.projects.metrics.contributors },
        { value: '2', label: t.projects.metrics.modules },
      ],
      highlights: [
        { label: t.projects.metrics.openSource, color: 'rgba(139, 92, 246, 0.15)' },
      ],
      meshBlobs: [
        { color: 'rgba(139, 92, 246, 0.2)', position: 'top: -10%; left: -5%;', animation: 'meshFloat1 8s ease-in-out infinite' },
        { color: 'rgba(6, 182, 212, 0.15)', position: 'bottom: 10%; right: -10%;', animation: 'meshFloat3 10s ease-in-out infinite' },
      ],
      links: [
        { label: 'GitHub', url: 'https://github.com/openhive-network/denser' },
        { label: 'Blog', url: 'https://blog.openhive.network', primary: true },
        { label: 'Wallet', url: 'https://wallet.openhive.network', primary: true },
      ],
    },
  ],
  [
    {
      title: 'ProjectHub',
      description: t.projects.descriptions.projectHub,
      tags: ['React 19', 'Zustand', 'DnD Kit', 'Recharts', 'Tailwind v4'],
      type: 'Full-Stack App',
      gradient: 'linear-gradient(135deg, #F97316 0%, #EAB308 100%)',
      accentColor: '#F97316',
      metrics: [],
      highlights: [
        { label: t.projects.metrics.kanban, color: 'rgba(249, 115, 22, 0.15)' },
        { label: t.projects.metrics.roleSystem, color: 'rgba(234, 179, 8, 0.12)' },
      ],
      meshBlobs: [
        { color: 'rgba(249, 115, 22, 0.2)', position: 'top: -10%; right: -5%;', animation: 'meshFloat2 10s ease-in-out infinite' },
        { color: 'rgba(234, 179, 8, 0.12)', position: 'bottom: -15%; left: -10%;', animation: 'meshFloat3 12s ease-in-out infinite' },
      ],
      links: [
        { label: 'Live', url: 'https://projecthub.bard-dev.com', primary: true },
      ],
    },
    {
      title: 'Stasiak Opal',
      description: t.projects.descriptions.stasiakOpal,
      tags: ['React 19', 'TanStack Router', 'Tailwind'],
      type: 'Client',
      gradient: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)',
      accentColor: '#3B82F6',
      metrics: [],
      highlights: [
        { label: t.projects.metrics.clientProject, color: 'rgba(59, 130, 246, 0.15)' },
        { label: t.projects.metrics.seoOptimized, color: 'rgba(6, 182, 212, 0.12)' },
      ],
      meshBlobs: [
        { color: 'rgba(59, 130, 246, 0.2)', position: 'top: -10%; left: -5%;', animation: 'meshFloat1 10s ease-in-out infinite' },
        { color: 'rgba(6, 182, 212, 0.15)', position: 'bottom: -10%; right: -10%;', animation: 'meshFloat2 13s ease-in-out infinite' },
      ],
      links: [
        { label: 'Live', url: 'https://stasiak-opal.pl', primary: true },
      ],
    },
  ],
];
---

<section id="projects" class="py-20 lg:py-28" style="background: var(--color-bg-alt);">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="section-tag">{t.projects.tag}</span>
      <h2 class="section-title">{t.projects.title}</h2>
    </div>

    <!-- Hero Project (ConqSite) — full width -->
    <article class="project-showcase animate-on-scroll mb-8 lg:mb-12" data-stagger-index={0}>
      <div class="showcase-accent" style={`background: ${heroProject.gradient};`} aria-hidden="true"></div>
      {heroProject.meshBlobs.map((blob) => (
        <div class="mesh-blob" aria-hidden="true"
          style={`background: radial-gradient(ellipse, ${blob.color}, transparent 70%); ${blob.position} animation: ${blob.animation};`}
        ></div>
      ))}
      <div class="relative z-10 grid lg:grid-cols-[1fr_220px] gap-8 lg:gap-12 p-8 sm:p-10 lg:p-12">
        <div>
          <span class={`inline-block text-[10px] font-semibold uppercase tracking-wider px-2 py-1 rounded border mb-4 ${typeColors[heroProject.type]}`}>
            {heroProject.type}
          </span>
          <h3 class="showcase-title mb-4">{heroProject.title}</h3>
          <p class="text-base leading-relaxed mb-6" style="color: var(--color-text-muted); max-width: 520px;">
            {heroProject.description}
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            {heroProject.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer"
                aria-label={link.primary
                  ? (link.label !== 'Live'
                      ? `${t.projects.viewProject} — ${heroProject.title} (${link.label})`
                      : `${t.projects.viewProject} — ${heroProject.title}`)
                  : `${link.label} — ${heroProject.title}`}
                class={`inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-full transition-all duration-200 hover:-translate-y-0.5 border ${
                  link.primary
                    ? 'text-[--color-text] hover:text-[--color-primary] hover:border-[--color-primary]'
                    : 'text-[--color-text-muted] hover:text-[--color-text]'
                }`}
                style={link.primary ? 'border-color: var(--color-border-hover);' : 'border-color: var(--color-border);'}
              >
                {link.primary ? t.projects.viewProject : link.label}
                <span class="text-xs" aria-hidden="true">&nearr;</span>
              </a>
            ))}
          </div>
          <div class="flex flex-wrap gap-2">
            {heroProject.tags.map((tag) => (
              <span class="text-xs px-3 py-1.5 rounded-lg" style="color: var(--color-text-muted); background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
                {tag}
              </span>
            ))}
          </div>
        </div>
        <div class="flex flex-row lg:flex-col gap-6 lg:gap-8 lg:border-l lg:pl-8" style="border-color: var(--color-border);">
          {heroProject.metrics.map((metric) => (
            <div>
              <div class="metric-number" style={`color: ${heroProject.accentColor};`}>{metric.value}</div>
              <div class="metric-label">{metric.label}</div>
            </div>
          ))}
          {heroProject.highlights.map((highlight) => (
            <div>
              <span class="metric-tag" style={`background: ${highlight.color}; color: var(--color-text);`}>
                {highlight.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </article>

    <!-- Secondary Projects — 2-column grid rows -->
    {secondaryProjects.map((row, rowIndex) => (
      <div class="grid md:grid-cols-2 gap-6 lg:gap-8 mb-8 lg:mb-12">
        {row.map((project, colIndex) => (
          <article class="project-showcase project-showcase-compact animate-on-scroll" data-stagger-index={rowIndex * 2 + colIndex + 1}>
            <div class="showcase-accent" style={`background: ${project.gradient};`} aria-hidden="true"></div>
            {project.meshBlobs.map((blob) => (
              <div class="mesh-blob" aria-hidden="true"
                style={`background: radial-gradient(ellipse, ${blob.color}, transparent 70%); ${blob.position} animation: ${blob.animation};`}
              ></div>
            ))}
            <div class="relative z-10 p-6 lg:p-8">
              <span class={`inline-block text-[10px] font-semibold uppercase tracking-wider px-2 py-1 rounded border mb-3 ${typeColors[project.type]}`}>
                {project.type}
              </span>
              <h3 class="showcase-title-compact mb-3">{project.title}</h3>
              <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text-muted);">
                {project.description}
              </p>

              <!-- Metrics -->
              {(project.metrics.length > 0 || project.highlights.length > 0) && (
                <div class="flex flex-col gap-3 mb-4">
                  {project.metrics.length > 0 && (
                    <div class="flex flex-wrap gap-6">
                      {project.metrics.map((metric) => (
                        <div>
                          <span class="metric-number-compact" style={`color: ${project.accentColor};`}>{metric.value}</span>
                          <span class="text-xs ml-1.5" style="color: var(--color-text-muted);">{metric.label}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {project.highlights.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {project.highlights.map((highlight) => (
                        <span class="metric-tag" style={`background: ${highlight.color}; color: var(--color-text);`}>
                          {highlight.label}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              )}

              <!-- Links -->
              {project.links.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer"
                      aria-label={link.primary
                        ? (link.label !== 'Live'
                            ? `${t.projects.viewProject} — ${project.title} (${link.label})`
                            : `${t.projects.viewProject} — ${project.title}`)
                        : `${link.label} — ${project.title}`}
                      class={`inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full transition-all duration-200 hover:-translate-y-0.5 border ${
                        link.primary
                          ? 'text-[--color-text] hover:text-[--color-primary] hover:border-[--color-primary]'
                          : 'text-[--color-text-muted] hover:text-[--color-text]'
                      }`}
                      style={link.primary ? 'border-color: var(--color-border-hover);' : 'border-color: var(--color-border);'}
                    >
                      {link.primary ? t.projects.viewProject : link.label}
                      <span class="text-[10px]" aria-hidden="true">&nearr;</span>
                    </a>
                  ))}
                </div>
              )}

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="text-[11px] px-2.5 py-1 rounded-lg" style="color: var(--color-text-muted); background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    ))}

    <!-- CTA -->
    <div class="text-center mt-4">
      <a href="https://github.com/KKocot" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
        {t.projects.viewAll}
      </a>
    </div>
  </div>
</section>
