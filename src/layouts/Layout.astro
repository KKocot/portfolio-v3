---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { Language } from '../i18n';
import portraitSrc from '../assets/portrait.jpg';
import {
  PORTRAIT_WIDTHS,
  PORTRAIT_SIZES,
  PORTRAIT_FORMAT,
  PORTRAIT_QUALITY,
} from '../lib/portrait';

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  pathname?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = 'Full-Stack Developer & Freelancer from Katowice. I specialize in Next.js, React, TypeScript and Node.js.',
  lang = 'en',
  pathname,
  ogImageAlt = 'Portrait of Krzysztof Kocot, Full-Stack Developer from Katowice',
} = Astro.props;

const siteUrl = 'https://kkocot.dev';
const resolvedPathname = pathname ?? Astro.url.pathname;
const canonicalUrl = new URL(resolvedPathname, siteUrl).href;
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';
const ogImageUrl = new URL('/og-image.jpg', siteUrl).href;

// LCP preload: same source + params as Hero.astro <Image> (shared via lib/portrait)
// so the preload srcset URLs are identical to the rendered <img> srcset.
const portraitPreload = await getImage({
  src: portraitSrc,
  widths: PORTRAIT_WIDTHS,
  sizes: PORTRAIT_SIZES,
  format: PORTRAIT_FORMAT,
  quality: PORTRAIT_QUALITY,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Krzysztof Kocot" />
    <meta name="theme-color" content="#001B15" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
    <!-- LCP preload: hero portrait. href is the fallback candidate; imagesrcset
         matches the rendered Hero.astro <Image> candidates. -->
    <link
      rel="preload"
      as="image"
      href={portraitPreload.src}
      imagesrcset={portraitPreload.srcSet.attribute}
      imagesizes={PORTRAIT_SIZES}
      fetchpriority="high"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="pl" href={`${siteUrl}/pl/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen" style={`background: var(--color-bg);`}>
    <!-- Skip link for keyboard navigation -->
    <a href="#main" class="skip-link">
      {lang === 'pl' ? 'Przejdź do treści' : 'Skip to content'}
    </a>
    <slot />
    <script>
      // Mobile menu toggle
      const menuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links-mobile');
      const menuLines = menuBtn?.querySelectorAll('.menu-line');

      function toggleMenu(open: boolean) {
        if (!navLinks || !menuLines || !menuBtn) return;

        menuBtn.setAttribute('aria-expanded', String(open));

        if (open) {
          navLinks.classList.remove('hidden');
          navLinks.classList.add('flex');
          menuLines[0]?.classList.add('rotate-45', 'translate-y-2');
          menuLines[1]?.classList.add('opacity-0');
          menuLines[2]?.classList.add('-rotate-45', '-translate-y-2');
        } else {
          navLinks.classList.add('hidden');
          navLinks.classList.remove('flex');
          menuLines[0]?.classList.remove('rotate-45', 'translate-y-2');
          menuLines[1]?.classList.remove('opacity-0');
          menuLines[2]?.classList.remove('-rotate-45', '-translate-y-2');
        }
      }

      menuBtn?.addEventListener('click', () => {
        const isOpen = !navLinks?.classList.contains('hidden');
        toggleMenu(!isOpen);
      });

      // Close mobile menu on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !navLinks?.classList.contains('hidden')) {
          toggleMenu(false);
          (menuBtn as HTMLElement)?.focus();
        }
      });

      // Close mobile menu on link click
      navLinks?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          toggleMenu(false);
        });
      });

      // Scroll spy for nav highlighting — IntersectionObserver instead of a scroll
      // listener reading offsetTop/offsetHeight on every frame (layout thrashing)
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
      const desktopNavLinks = document.querySelectorAll('.nav-link[data-section]');

      function setActiveNav(currentSection: string) {
        mobileNavLinks.forEach(link => {
          const isActive = link.getAttribute('data-section') === currentSection;
          (link as HTMLElement).style.color = isActive
            ? 'var(--color-primary)'
            : 'var(--color-text-muted)';
        });

        desktopNavLinks.forEach(link => {
          link.classList.toggle('active', link.getAttribute('data-section') === currentSection);
        });
      }

      // Active = section crossing the band between 100px from the top and 35% of
      // the viewport (mirrors the previous scrollY + 100 heuristic)
      const scrollSpyObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            setActiveNav(entry.target.id);
          }
        });
      }, { rootMargin: '-100px 0px -65% 0px', threshold: 0 });

      document.querySelectorAll('section[id]').forEach(section => {
        scrollSpyObserver.observe(section);
      });
    </script>
  </body>
</html>
