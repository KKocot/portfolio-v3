---
import '../styles/global.css';
import type { Language } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  pathname?: string;
}

const {
  title,
  description = 'Full-Stack Developer & Freelancer from Katowice. I specialize in Next.js, React, TypeScript and Node.js.',
  lang = 'en',
  pathname,
} = Astro.props;

const siteUrl = 'https://kkocot.dev';
const resolvedPathname = pathname ?? Astro.url.pathname;
const canonicalUrl = new URL(resolvedPathname, siteUrl).href;
const ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Krzysztof Kocot" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="pl" href={`${siteUrl}/pl/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen" style={`background: var(--color-bg);`}>
    <!-- Skip link for keyboard navigation -->
    <a href="#main" class="skip-link">
      {lang === 'pl' ? 'Przejdź do treści' : 'Skip to content'}
    </a>
    <slot />
    <script>
      // Mobile menu toggle
      const menuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links-mobile');
      const menuLines = menuBtn?.querySelectorAll('.menu-line');

      function toggleMenu(open: boolean) {
        if (!navLinks || !menuLines || !menuBtn) return;

        menuBtn.setAttribute('aria-expanded', String(open));

        if (open) {
          navLinks.classList.remove('hidden');
          navLinks.classList.add('flex');
          menuLines[0]?.classList.add('rotate-45', 'translate-y-2');
          menuLines[1]?.classList.add('opacity-0');
          menuLines[2]?.classList.add('-rotate-45', '-translate-y-2');
        } else {
          navLinks.classList.add('hidden');
          navLinks.classList.remove('flex');
          menuLines[0]?.classList.remove('rotate-45', 'translate-y-2');
          menuLines[1]?.classList.remove('opacity-0');
          menuLines[2]?.classList.remove('-rotate-45', '-translate-y-2');
        }
      }

      menuBtn?.addEventListener('click', () => {
        const isOpen = !navLinks?.classList.contains('hidden');
        toggleMenu(!isOpen);
      });

      // Close mobile menu on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !navLinks?.classList.contains('hidden')) {
          toggleMenu(false);
          (menuBtn as HTMLElement)?.focus();
        }
      });

      // Close mobile menu on link click
      navLinks?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          toggleMenu(false);
        });
      });

      // Scroll animations — inline styles instead of Tailwind classes
      // (Tailwind 4 does not compile classes added dynamically via classList)
      const observerOptions = { root: null, rootMargin: '0px 0px -80px 0px', threshold: 0.01 };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            // Stagger support
            if (target.dataset.staggerIndex) {
              const delay = parseInt(target.dataset.staggerIndex) * 80;
              target.style.transitionDelay = `${delay}ms`;
            }
            target.style.opacity = '1';
            target.style.transform = 'translateY(0)';
            observer.unobserve(target);
          }
        });
      }, observerOptions);

      document.querySelectorAll<HTMLElement>('.animate-on-scroll').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(2rem)';
        el.style.transition = 'opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
        observer.observe(el);
      });

      // Scroll spy for nav highlighting
      const sections = document.querySelectorAll('section[id]');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
      const desktopNavLinks = document.querySelectorAll('.nav-link[data-section]');

      function updateActiveNav() {
        const scrollY = window.scrollY + 100;

        let currentSection = '';
        sections.forEach(section => {
          const sectionTop = (section as HTMLElement).offsetTop;
          const sectionHeight = (section as HTMLElement).offsetHeight;
          if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
            currentSection = section.getAttribute('id') || '';
          }
        });

        // Update mobile nav
        mobileNavLinks.forEach(link => {
          const section = link.getAttribute('data-section');
          if (section === currentSection) {
            (link as HTMLElement).style.color = 'var(--color-primary)';
          } else {
            (link as HTMLElement).style.color = 'var(--color-text-muted)';
          }
        });

        // Update desktop nav
        desktopNavLinks.forEach(link => {
          const section = link.getAttribute('data-section');
          if (section === currentSection) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      window.addEventListener('scroll', updateActiveNav);
      updateActiveNav();
    </script>
  </body>
</html>
